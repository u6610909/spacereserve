# Production env for the Azure VM — copy to `.env` next to
# docker-compose.prod.yml. The four AZURE_* values are required; the
# AD_* / FRONTEND_URL block is optional and only wires up OIDC login.
# Every actual secret (database URL, JWT secret, AD client id/secret,
# Gemini/SendGrid/FinderAI keys) is fetched from Key Vault at boot and never
# belongs here. See DEPLOY.md for where each value comes from in the portal.
#
# NEVER commit the filled-in .env.

# --- Service principal that reads Key Vault -------------------------------
# Azure portal → Microsoft Entra ID → App registrations → <your app> →
#   Overview:            Application (client) ID  -> AZURE_CLIENT_ID
#                        Directory (tenant) ID    -> AZURE_TENANT_ID
#   Certificates & secrets → New client secret    -> AZURE_CLIENT_SECRET
# The app must have the "Key Vault Secrets User" role on the vault
# (Key Vault → Access control (IAM) → Add role assignment).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- The vault's address (not a secret) ---------------------------------
# Azure portal → Key Vault → <your vault> → Overview → Vault URI
# e.g. https://spacereserve-kv.vault.azure.net/
AZURE_KEY_VAULT_URL=

# --- OIDC login (not secrets — both values are public) -----------------
# The "@au.edu login" app registration, SEPARATE from the Key Vault one
# above. Its client id / secret go into Key Vault as SpaceReserve-AdClientId
# / SpaceReserve-AdClientSecret; only these two non-secret bits ride in env.
#   AD_TENANT_ID  = that app registration's Directory (tenant) ID
#   AD_REDIRECT_URI = the Web redirect URI registered on it, which must be
#     https://<domain>/spacereserve/api/v1/auth/callback
# Leave both blank to run with no login provider wired.
AD_TENANT_ID=
AD_REDIRECT_URI=

# --- Optional ---------------------------------------------------------------
# Where /auth/callback redirects after login. Blank -> it returns the JWT as
# JSON instead (fine for an API-only / Postman demo).
# FRONTEND_URL=https://spacereserve.eastasia.cloudapp.azure.com/spacereserve/
# APP_VERSION=0.1.0
