# Production env for the Azure VM — copy to `.env` next to
# docker-compose.prod.yml and fill in the four values below. Nothing else
# goes here: every other secret (database URL, JWT secret, AD client
# id/secret, Gemini/SendGrid/FinderAI keys) is fetched from Key Vault at
# boot. See DEPLOY.md for where each value comes from in the Azure portal.
#
# NEVER commit the filled-in .env.

# --- Service principal that reads Key Vault -------------------------------
# Azure portal → Microsoft Entra ID → App registrations → <your app> →
#   Overview:            Application (client) ID  -> AZURE_CLIENT_ID
#                        Directory (tenant) ID    -> AZURE_TENANT_ID
#   Certificates & secrets → New client secret    -> AZURE_CLIENT_SECRET
# The app must have the "Key Vault Secrets User" role on the vault
# (Key Vault → Access control (IAM) → Add role assignment).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- The vault's address (not a secret) ---------------------------------
# Azure portal → Key Vault → <your vault> → Overview → Vault URI
# e.g. https://spacereserve-kv.vault.azure.net/
AZURE_KEY_VAULT_URL=

# --- Optional -----------------------------------------------------------
# APP_VERSION=0.1.0
