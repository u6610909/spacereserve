# Local development only. There is NO .env in production — the app fetches every
# secret from Azure Key Vault at boot and refuses to start if the vault is
# unreachable (MASTER_PROMPT §9).
#
# Copy to .env and fill in. Never commit .env. Never put real values here.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
APP_VERSION=0.1.0
# Comma-separated allow-list of browser origins. Empty = no cross-origin callers.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Azure Key Vault bootstrap
# In production these three are the ONLY environment variables the container
# gets. Everything below them comes from the vault at runtime.
# ---------------------------------------------------------------------------
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Dev fallbacks for the Key Vault secret table (names mirror the vault exactly).
# Production reads these from Key Vault instead; see CLAUDE.md.
#
#   Vault secret name              -> local variable
#   SpaceReserve-DatabaseUrl       -> DATABASE_URL
#   SpaceReserve-JwtSecret         -> JWT_SECRET (also signs the OIDC/PKCE cookies)
#   SpaceReserve-AdClientId        -> AD_CLIENT_ID
#   SpaceReserve-AdClientSecret    -> AD_CLIENT_SECRET
#   SpaceReserve-GeminiApiKey      -> GEMINI_API_KEY
#   SpaceReserve-SendGridApiKey    -> SENDGRID_API_KEY
#   SpaceReserve-FinderAIApiKey    -> FINDERAI_API_KEY
#   SpaceReserve-PeerApiKeyHash    -> PEER_API_KEY_HASH
# ---------------------------------------------------------------------------
DATABASE_URL=
JWT_SECRET=
COOKIE_SECRET=
AD_CLIENT_ID=
AD_CLIENT_SECRET=
GEMINI_API_KEY=
SENDGRID_API_KEY=
FINDERAI_API_KEY=
PEER_API_KEY_HASH=

# ---------------------------------------------------------------------------
# Non-secret config. AU's Entra tenant id is public information, but it lives
# here (and in the vault table in the README) so switching tenants is one
# obvious place.
#   AU tenant:  c1f3dc23-b7f8-48d3-9b5d-2b12f158f01f
#   Use a personal Entra tenant id until AU's app registration is issued.
# ---------------------------------------------------------------------------
AD_TENANT_ID=
AD_REDIRECT_URI=http://localhost:4000/spacereserve/api/v1/auth/callback
FINDERAI_BASE_URL=
